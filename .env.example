# Supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
# Service-role key — SERVER ONLY (used by /api/admin, /api/notify, /api/team).
# Never expose to the client. Bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Web Push (VAPID) — generate with: npx web-push generate-vapid-keys
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key      # SERVER ONLY (/api/notify)
VAPID_SUBJECT=https://mat-mind.com            # mailto: or https: identifier

# Multi-team subdomain routing
# Set to your root domain so subdomains are resolved to teams.
# e.g. VITE_ROOT_DOMAIN=mat-mind.com  →  lovett.mat-mind.com resolves slug 'lovett'
# Leave blank for localhost dev (subdomain detection is disabled when unset).
VITE_ROOT_DOMAIN=

# Anthropic (Claude API — called from Edge Functions, NOT from client)
ANTHROPIC_API_KEY=your-anthropic-key-here

# Twilio (SMS — called from Edge Functions)
TWILIO_ACCOUNT_SID=your-twilio-sid
TWILIO_AUTH_TOKEN=your-twilio-token
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX

# SendGrid (Email — called from Edge Functions)
SENDGRID_API_KEY=your-sendgrid-key
