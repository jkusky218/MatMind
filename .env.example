# App domain — slug resolution only fires on this domain.
# Vercel previews, localhost, etc. automatically fall back to demo mode.
# Default: mat-mind.com  (only set this if using a custom domain)
# VITE_APP_DOMAIN=mat-mind.com

# Supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Anthropic (Claude API — called from Edge Functions, NOT from client)
ANTHROPIC_API_KEY=your-anthropic-key-here

# Twilio (SMS — called from Edge Functions)
TWILIO_ACCOUNT_SID=your-twilio-sid
TWILIO_AUTH_TOKEN=your-twilio-token
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX

# SendGrid (Email — called from Edge Functions)
SENDGRID_API_KEY=your-sendgrid-key
